<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account.res_partner_action_customer" model="ir.actions.act_window">
            <field name="domain">[('customer_rank','>',0)]</field>
        </record>
        
        <record id="view_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.view.move.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="context">{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True, 'default_customer_rank': 10}</attribute>
                </xpath>
            </field>
        </record>

        <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
            <field name="domain">[('supplier_rank','>',0)]</field>
        </record>
        
        <record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.view.move.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="context">{'res_partner_search_mode': 'supplier', 'show_address': 1, 'show_vat': True, 'default_supplier_rank': 10}</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="customer_id" context="{'show_address': 1}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>